      "wdi_definition": {
        "id": "SE.ADT.LITR.ZS",
        "name": "Literacy rate, adult total (% of people ages 15 and above)",
        "unit": "",
        "source": {
          "id": "2",
          "value": "World Development Indicators"
        },
        "sourceNote": "Adult literacy rate is the percentage of people ages 15 and above who can both read and write with understanding a short simple statement about their everyday life.",
        "sourceOrganization": "Data API, UN Educational, Scientific and Cultural Organization (UNESCO), uri: https://databrowser.uis.unesco.org/resources, note: The data are obtained through the UIS API.  Detailed documentation is available at: https://api.uis.unesco.org/api/public/documentation/, publisher: UNESCO Institute for Statistics (UIS), type: Excel (bulk file), date accessed: 2026-03-19, date published: 2026-02",
